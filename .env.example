# Copy ke .env dan isi nilai sesuai environment kamu
# Contoh konfigurasi untuk integrasi Telegram (opsional)

# 1. Buat bot baru melalui @BotFather, copy token ke TELEGRAM_BOT_TOKEN
# 2. Dapatkan chat_id kamu melalui @userinfobot (kirim pesan apa saja ke @userinfobot, copy User ID)
#    atau tambahkan bot ke grup, kirim pesan, lalu cek https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=123456789
